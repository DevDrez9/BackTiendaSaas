# ---------- Base de datos (MySQL instalado en el servidor) ----------
# El backend usa la red del host, así que 127.0.0.1 es el MySQL del servidor.
DATABASE_URL=mysql://USUARIO:PASSWORD@127.0.0.1:3306/tienda

# ---------- Docker ----------
# Volumen donde se guardan las imágenes subidas
UPLOADS_VOLUME_NAME=tienda_uploads
# Puerto del servidor donde se publica el frontend (debe coincidir con cloudflared)
FRONTEND_PORT=8080

# ---------- App ----------
NODE_ENV=production
PORT=3000
# URL pública del backend (se usa en las URLs de las imágenes). Ej: https://api.tudominio.com
APP_URL=http://localhost:3000
# URL pública del frontend (CORS). Ej: https://tudominio.com
FRONTEND_URL=http://localhost:5173
# Genera uno largo y aleatorio: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# 1 si el backend está detrás de nginx / un proxy / túnel de Cloudflare (para leer la IP real)
TRUST_PROXY=1
# Swagger en /api: false en producción
SWAGGER_ENABLED=false

# ---------- Pasarela de pagos ----------
BANCO_GATEWAY_URL=
BANCO_GATEWAY_API_KEY=
BANCO_WEBHOOK_SECRET=

# ---------- Correo (Brevo, plan gratis 300 correos/día) ----------
# https://app.brevo.com -> SMTP & API -> API Keys. Sin clave, los correos se imprimen en la consola.
BREVO_API_KEY=
# Remitente verificado en Brevo (Senders & IP -> Senders)
MAIL_FROM_EMAIL=
MAIL_FROM_NAME=micatalogo
